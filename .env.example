# Copiez ce fichier en .env et adaptez les valeurs

# IP de votre NAS Synology (ou PC)
NAS_IP=192.168.1.109

# Port pour l'interface web du jeu
CLIENT_PORT=3000

# Chemin vers le dossier contenant vos illustrations WebP
# Exemple : /volume3/docker/tennistcg/artworks
# Les fichiers doivent être nommés comme les artworkPath dans cards.json
# Ex: nadal_base.webp, djokovic_stage2.webp, energy_terre.webp, etc.
ARTWORKS_PATH=./artworks
